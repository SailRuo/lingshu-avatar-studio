{
  "name": "lingshu-avatar-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Local 2D digital human studio",
  "author": "Avatar Studio",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:app": "tauri build --bundles app",
    "dev:web": "npm run prepare:assets && vite",
    "build:web": "npm run prepare:assets && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "models:verify": "node scripts/verify-models.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "landing:dev": "vite landing --port 5190"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "@tauri-apps/api": "^2.12.4",
    "ag-psd": "^26.0.0",
    "fflate": "^0.8.2",
    "idb": "^8.0.2",
    "lucide-vue-next": "^0.468.0",
    "onnxruntime-web": "^1.30.0",
    "pinia": "^3.0.1",
    "pixi.js": "^8.6.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
